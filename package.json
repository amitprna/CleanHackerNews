{
  "name": "clean-hacker-news",
  "private": true,
  "type": "module",
  "description": "Hacker News's top stories of the week, ranked by points, each with a short AI summary so you know what's worth opening.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "refresh:local": "node scripts/refresh-local.mjs",
    "refresh:mock": "node scripts/refresh-local.mjs --mock",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0"
  }
}
